<?xml version="1.0" encoding="utf-8"?>
<!-- The source design (rounded-square card, radial gradient, drop shadow, corner glows) is a
     fully pre-rendered image, not a foreground/background pair meant to be re-masked into a
     circle/squircle by the OS — so the whole bitmap is the background layer and the foreground is
     left empty, same technique used for any pre-baked icon adapted into the adaptive-icon system.
     The OS's own mask still clips it to whatever shape the launcher uses, same as it would any
     other regular icon. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_adaptive" />
    <foreground android:drawable="@android:color/transparent" />
</adaptive-icon>
