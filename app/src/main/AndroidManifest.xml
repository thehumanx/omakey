<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Normal-protection permission, granted automatically at install with no runtime prompt and
         no data access — used only for the key-press haptic feedback. Does not affect the
         offline-by-default claim (no network access is granted or used anywhere in this app). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- The one deliberate exception to "works entirely offline": update checking. A manual
         "Check for updates" button in Settings (About section), plus — by direct user request —
         an opt-out periodic background check every 12 hours (WorkManager, network-connected
         constraint) that posts a system notification if a newer release exists. Either way, the
         only endpoint ever contacted is GitHub's public Releases API — no telemetry, no
         auto-download/install. See core/.../update/UpdateChecker.kt,
         app/.../update/UpdateCheckWorker.kt, and the privacy notice (strings.xml). Toggleable off
         in Settings (UpdatePreferences.autoCheckEnabled) without affecting the manual button. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- POST_NOTIFICATIONS (for the update-available notification) is declared only in the sideload
         flavor's manifest: src/sideload/AndroidManifest.xml. The Play build has no update check. -->

    <!-- usesCleartextTraffic: targetSdk 35+ already defaults this to false. Declared explicitly so
         that lowering targetSdk later cannot silently re-enable plaintext HTTP for the single
         network call this app makes (the GitHub release check). -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Omakey">

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Not exported: only omakey opens it, so no other app can open a secret snippet's form.
             No task affinity of the launcher's, so opening it from the keyboard doesn't drag
             Settings to the front. -->
        <activity
            android:name=".settings.SnippetsActivity"
            android:exported="false"
            android:label="@string/snippets_title"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".keyboard.OmakeyInputMethodService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

    </application>

</manifest>
